# Shop convention, documentation only. See CORRECTION 1.
PARENT_CURSOR_OPEN_NUMBER = 710
CHILD_CURSOR_MINIMUM_NUMBER = 810
PARAGRAPH_NUMBER_SEPARATOR = "-"

# ---------------------------------------------------------------------
# Fixed-format geometry for scanning the SOURCE program
# ---------------------------------------------------------------------
