# =====================================================================
# APPLICATION - XY drives every {XY} placeholder below
# =====================================================================
ZOWE_APPLICATION=VM




# =====================================================================
# GLOBAL DEV CONNECTION (TSOC / CPUC)
# =====================================================================
ZOWE_HOST=cpuc.belwired.net
ZOWE_PORT=32208
ZOWE_USER=ankarm
ZOWE_PASSWORD=Magesh@1
ZOWE_VERIFY_TLS=false
ZOWE_TIMEOUT_SECONDS=60




# =====================================================================
# 1. PROGRAM  - input IDMS COBOL          Dev / TSOC / CPUC
# =====================================================================
ZOWE_PROGRAM_HOST=${ZOWE_HOST}
ZOWE_PROGRAM_PORT=${ZOWE_PORT}
ZOWE_PROGRAM_USER=${ZOWE_USER}
ZOWE_PROGRAM_PASSWORD=${ZOWE_PASSWORD}
ZOWE_PROGRAM_VERIFY_TLS=${ZOWE_VERIFY_TLS}
ZOWE_PROGRAM_LIBRARIES=BAS.{XY}.CBL




# =====================================================================
# 2. COPYBOOK - searched in this order    Dev / TSOC / CPUC
# =====================================================================
ZOWE_COPYBOOK_HOST=${ZOWE_HOST}
ZOWE_COPYBOOK_PORT=${ZOWE_PORT}
ZOWE_COPYBOOK_USER=${ZOWE_USER}
ZOWE_COPYBOOK_PASSWORD=${ZOWE_PASSWORD}
ZOWE_COPYBOOK_VERIFY_TLS=${ZOWE_VERIFY_TLS}
ZOWE_COPYBOOK_LIBRARIES=BAS.SCOB.COPYLIB,BAS.{XY}.CPY,BAS.{XY}.CPP,BAS.{XY}.C00,BAS.{XY}.C10,BAS.{XY}.C19,BAS.{XY}.C20,BAS.{XY}.C40




# =====================================================================
# 3. DCLGEN - member derived as DZ + last4(IDMS record) + TV
# =====================================================================
ZOWE_DCLGEN_HOST=${ZOWE_HOST}
ZOWE_DCLGEN_PORT=${ZOWE_PORT}
ZOWE_DCLGEN_USER=${ZOWE_USER}
ZOWE_DCLGEN_PASSWORD=${ZOWE_PASSWORD}
ZOWE_DCLGEN_VERIFY_TLS=${ZOWE_VERIFY_TLS}
ZOWE_DCLGEN_LIBRARIES=ES.BDB2.VIEW.COB.TST




# =====================================================================
# 4. SUBSCHEMA - PRODUCTION, different TSO and CPU
# =====================================================================
ZOWE_SUBSCHEMA_HOST=cpub.belwired.net
ZOWE_SUBSCHEMA_PORT=32208
ZOWE_SUBSCHEMA_USER=ankarm
ZOWE_SUBSCHEMA_PASSWORD=
ZOWE_SUBSCHEMA_VERIFY_TLS=true
ZOWE_SUBSCHEMA_LIBRARIES=ZG.BPRD.SIDM.SUBSCHEM




# =====================================================================
# OUTPUT - converted DB2 COBOL            Dev / TSOC / CPUC
# =====================================================================
ZOWE_OUTPUT_HOST=${ZOWE_HOST}
ZOWE_OUTPUT_PORT=${ZOWE_PORT}
ZOWE_OUTPUT_USER=${ZOWE_USER}
ZOWE_OUTPUT_PASSWORD=${ZOWE_PASSWORD}
ZOWE_OUTPUT_VERIFY_TLS=${ZOWE_VERIFY_TLS}
ZOWE_OUTPUT_DATASET=ANKARM.B.PDS.CBL.AUTO
ZOWE_OUTPUT_READ_ONLY=false




# =====================================================================
# PROGRAM SELECTION - the array that drives the batch.
# Inline list wins; otherwise zowe/program_list.txt is read.
# =====================================================================
ZOWE_PROGRAMS=
ZOWE_PROGRAM_LIST_FILE=program_list.txt




# Reference only. NEVER used as input.
ZOWE_REFERENCE_LIBRARY=ANKARM.B.PDS.CBL






